<Page
    x:Class="MyTodo.App.Views.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Style="{StaticResource CardBorderStyle}" Padding="40,36" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12">
            <StackPanel Spacing="22">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Image Source="ms-appx:///Assets/Square150x150Logo.png" Width="64" Height="64" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Welcome to My To-Do" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Your tasks, calendar and diary, on this PC." Foreground="{ThemeResource Text2Brush}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Text="Everything works offline and stays on this PC. Reminders appear as Windows notifications, even when the window is closed." />
                <Border Background="{ThemeResource Surface2Brush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <RadioButtons x:Name="ThemeRadio" Header="Theme" MaxColumns="3" SelectionChanged="Theme_Changed">
                            <x:String>Light</x:String>
                            <x:String>Dark</x:String>
                            <x:String>Use system setting</x:String>
                        </RadioButtons>
                        <ToggleSwitch x:Name="StartupToggle" Header="Launch at Windows startup" IsOn="True" />
                        <ToggleSwitch x:Name="SoundToggle" Header="Reminder sound (1 hour, 30 minutes and 15 minutes before)" IsOn="True" />
                    </StackPanel>
                </Border>
                <InfoBar x:Name="Notice" IsOpen="False" Severity="Warning" />
                <Button Content="Start using My To-Do" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="40" Click="Start_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
