<Page
    x:Class="MyTodo.App.Views.TodayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MyTodo.App.Controls">

    <Grid Padding="28,20,28,0" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock Text="Today" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock x:Name="DateText" Foreground="{ThemeResource Text2Brush}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="170" Spacing="6">
                    <TextBlock x:Name="ProgressText" FontSize="12" Foreground="{ThemeResource Text2Brush}" />
                    <ProgressBar x:Name="Progress" Maximum="1" />
                </StackPanel>
            </Grid>

            <TextBox x:Name="AddBox" Grid.Row="1" PlaceholderText="Add a task, e.g. &#x201C;Call vendor tomorrow 3pm p1 #work&#x201D;  (Ctrl+N)"
                     KeyDown="AddBox_KeyDown" AutomationProperties.Name="Add a task" />

            <Grid x:Name="TimerBar" Grid.Row="2" Visibility="Collapsed" Padding="12,8" CornerRadius="6" ColumnSpacing="12" Background="{ThemeResource AccentSoftBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE916;" FontSize="16" Foreground="{ThemeResource BrandAccentBrush}" />
                <TextBlock x:Name="TimerText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TimerElapsed" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource BrandAccentBrush}" />
                <Button Grid.Column="3" Content="Stop" Style="{StaticResource AccentButtonStyle}" Click="StopTimer_Click" />
            </Grid>

            <InfoBar x:Name="UndoBar" Grid.Row="3" IsOpen="False" Severity="Informational" IsClosable="True" />

            <ListView x:Name="TaskList" Grid.Row="4" SelectionMode="Single" ItemTemplateSelector="{StaticResource TaskRowSelector}"
                      CanDragItems="True" DragItemsStarting="TaskList_DragItemsStarting" ItemClick="TaskList_ItemClick" IsItemClickEnabled="True"
                      Padding="0,0,0,24" AutomationProperties.Name="Today's tasks">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
            <StackPanel x:Name="EmptyState" Grid.Row="4" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE73E;" FontSize="28" Foreground="{ThemeResource BrandAccentBrush}" />
                <TextBlock Text="No tasks for today" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Press Ctrl+N, or Win+Shift+T from any app, to plan your day." Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Margin="0,0,0,20" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="Schedule" Style="{StaticResource SectionTitleStyle}" />
                <HyperlinkButton HorizontalAlignment="Right" Content="Open week" Click="OpenWeek_Click" Padding="0" />
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="8">
                <controls:WeekTimeline x:Name="Schedule" />
            </Border>
        </Grid>

        <SplitView x:Name="Split" Grid.ColumnSpan="2" PanePlacement="Right" OpenPaneLength="420" DisplayMode="Overlay" IsPaneOpen="False">
            <SplitView.Pane>
                <local:TaskDetailPanel xmlns:local="using:MyTodo.App.Views" x:Name="Detail" />
            </SplitView.Pane>
        </SplitView>
    </Grid>
</Page>
