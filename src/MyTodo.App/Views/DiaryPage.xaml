<Page
    x:Class="MyTodo.App.Views.DiaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <ScrollViewer BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,1,0">
            <StackPanel Padding="14,18" Spacing="12">
                <CalendarView x:Name="MiniCalendar" SelectionMode="Single" HorizontalAlignment="Stretch" FirstDayOfWeek="Monday"
                              CalendarViewDayItemChanging="MiniCalendar_DayItemChanging" SelectedDatesChanged="MiniCalendar_SelectedDatesChanged"
                              AutomationProperties.Name="Diary calendar" />
                <TextBlock Text="A bar under a date marks a day with an entry." Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Text="Recent entries" FontWeight="SemiBold" />
                <StackPanel x:Name="RecentList" Spacing="4" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1" Padding="28,18" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="DayTitle" Style="{StaticResource PageTitleStyle}" FontSize="26" />
                    <TextBlock x:Name="SavedText" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
                    <Button Click="PrevDay_Click" AutomationProperties.Name="Previous day (Ctrl+Page Up)"><FontIcon Glyph="&#xE76B;" FontSize="12" /></Button>
                    <Button Click="NextDay_Click" AutomationProperties.Name="Next day (Ctrl+Page Down)"><FontIcon Glyph="&#xE76C;" FontSize="12" /></Button>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="2" Padding="4" CornerRadius="6" Background="{ThemeResource SurfaceBrush}"
                        BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" AutomationProperties.Name="Formatting">
                <Button Content="B" FontWeight="Bold" Width="36" Click="Bold_Click" AutomationProperties.Name="Bold (Ctrl+B)" />
                <Button Content="I" FontStyle="Italic" Width="36" Click="Italic_Click" AutomationProperties.Name="Italic (Ctrl+I)" />
                <Button Width="36" Click="Underline_Click" AutomationProperties.Name="Underline (Ctrl+U)"><TextBlock Text="U" TextDecorations="Underline" /></Button>
                <Button Content="Heading" Click="Heading_Click" AutomationProperties.Name="Heading (Ctrl+Alt+1)" />
                <Button Click="Bullets_Click" AutomationProperties.Name="Bulleted list (Ctrl+Shift+L)"><FontIcon Glyph="&#xE8FD;" FontSize="14" /></Button>
                <Button Click="Link_Click" AutomationProperties.Name="Insert link (Ctrl+K)"><FontIcon Glyph="&#xE71B;" FontSize="14" /></Button>
            </StackPanel>
            <RichEditBox x:Name="Editor" Grid.Row="2" TextChanged="Editor_TextChanged" PlaceholderText="What happened today?"
                         AutomationProperties.Name="Diary entry" MaxWidth="760" HorizontalAlignment="Stretch" />
        </Grid>

        <ScrollViewer Grid.Column="2" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1,0,0,0">
            <StackPanel Padding="16,20" Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="DoneTitle" FontWeight="SemiBold" />
                    <StackPanel x:Name="DoneList" Spacing="4" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock x:Name="MeetingsTitle" FontWeight="SemiBold" />
                    <StackPanel x:Name="MeetingsList" Spacing="4" />
                </StackPanel>
                <Border Style="{StaticResource CardBorderStyle}" Background="{ThemeResource Surface2Brush}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="End-of-day summary" FontWeight="SemiBold" />
                        <Grid x:Name="SummaryGrid" ColumnSpacing="12" RowSpacing="6" />
                        <Button Content="Insert summary into entry" HorizontalAlignment="Stretch" Click="InsertSummary_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
