<Page
    x:Class="MyTodo.App.Views.ReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MyTodo.App.Views">

    <SplitView x:Name="DetailSplit" PanePlacement="Right" DisplayMode="Overlay" OpenPaneLength="440"
               IsPaneOpen="False" PaneClosed="Detail_PaneClosed" LightDismissOverlayMode="On">
        <SplitView.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
        </SplitView.KeyboardAccelerators>
        <SplitView.Pane>
            <local:TaskDetailPanel x:Name="Detail" />
        </SplitView.Pane>

        <Grid Padding="28,20,28,20" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <!-- The filter is the heading. A rail down the side cost a fifth of the width to say
                         the same thing, and the counts fit in the menu just as well. -->
                    <DropDownButton x:Name="FilterButton" HorizontalAlignment="Left" Padding="10,2" Background="Transparent"
                                    BorderThickness="0" AutomationProperties.Name="Choose a report">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="TitleText" Text="Report" Style="{StaticResource PageTitleStyle}" />
                            <FontIcon Glyph="&#xE70D;" FontSize="13" VerticalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="FilterMenu" Placement="BottomEdgeAlignedLeft" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <TextBlock x:Name="SubtitleText" Margin="10,0,0,0" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
                <DropDownButton x:Name="TagButton" Grid.Column="1" VerticalAlignment="Center" MinWidth="130"
                                HorizontalContentAlignment="Left" AutomationProperties.Name="Filter by tag">
                    <TextBlock x:Name="TagLabel" Text="All tags" TextTrimming="CharacterEllipsis" />
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="TagMenu" Placement="BottomEdgeAlignedLeft" />
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>

            <InfoBar x:Name="UndoBar" Grid.Row="1" IsOpen="False" Severity="Informational" />

            <Grid Grid.Row="2">
                <ListView x:Name="TaskList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="TaskList_ItemClick"
                          ItemTemplateSelector="{StaticResource TaskRowSelector}" CanDragItems="True"
                          DragItemsStarting="TaskList_DragItemsStarting" RightTapped="TaskList_RightTapped"
                          Padding="0,0,0,24" AutomationProperties.Name="Tasks">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete" Invoked="DeleteKey_Invoked" />
                        <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="CompleteKey_Invoked" />
                    </ListView.KeyboardAccelerators>
                </ListView>
                <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" MaxWidth="360" Style="{StaticResource SecondaryTextStyle}" />
            </Grid>
        </Grid>
    </SplitView>
</Page>
