<UserControl
    x:Class="MyTodo.App.Views.TaskDetailPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowDrop="True" DragOver="Panel_DragOver" Drop="Panel_Drop">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{ThemeResource SurfaceBrush}">
        <StackPanel Padding="20" Spacing="16">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="DoneCheck" MinWidth="0" VerticalAlignment="Top" Margin="0,4,0,0" Click="DoneCheck_Click"
                          AutomationProperties.Name="Completed (Ctrl+Enter)" />
                <TextBox x:Name="TitleBox" Grid.Column="1" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" AcceptsReturn="False"
                         BorderThickness="0" Background="Transparent" LostFocus="Field_LostFocus" AutomationProperties.Name="Task title" />
                <Button Grid.Column="2" Click="Close_Click" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Close details">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>

            <Grid ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="List" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                <ComboBox x:Name="ListCombo" Grid.Column="1" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="Field_Changed" AutomationProperties.Name="List" />
                <TextBlock Grid.Row="1" Text="Due" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                    <CalendarDatePicker x:Name="DuePicker" HorizontalAlignment="Stretch" PlaceholderText="No date" DateChanged="DuePicker_DateChanged"
                                        AutomationProperties.Name="Due date (Ctrl+D)" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleSwitch x:Name="TimeToggle" OnContent="At a time" OffContent="Any time" Toggled="TimeToggle_Toggled" MinWidth="0" />
                        <TimePicker x:Name="DueTime" ClockIdentifier="24HourClock" MinuteIncrement="5" SelectedTimeChanged="DueTime_Changed" AutomationProperties.Name="Due time" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="Priority" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                <ComboBox x:Name="PriorityCombo" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="Field_Changed" AutomationProperties.Name="Priority">
                    <x:String>None</x:String>
                    <x:String>P1 · Urgent</x:String>
                    <x:String>P2 · High</x:String>
                    <x:String>P3 · Medium</x:String>
                    <x:String>P4 · Low</x:String>
                </ComboBox>
                <TextBlock Grid.Row="3" Text="Repeat" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                <ComboBox x:Name="RepeatCombo" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="Field_Changed" AutomationProperties.Name="Repeat" />
                <TextBlock Grid.Row="4" Text="Tags" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                <TextBox x:Name="TagsBox" Grid.Row="4" Grid.Column="1" PlaceholderText="#q4 #planning" LostFocus="Field_LostFocus" AutomationProperties.Name="Tags" />
                <TextBlock Grid.Row="5" Text="Time blocks" VerticalAlignment="Top" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock x:Name="BlocksText" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" FontSize="13" />
            </Grid>

            <StackPanel Spacing="8">
                <TextBlock Text="Reminders" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock x:Name="NoDueReminderText" Text="Set a due date to get reminders." Style="{StaticResource SecondaryTextStyle}" />
                <ItemsControl x:Name="ReminderChips">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><VariableSizedWrapGrid Orientation="Horizontal" ItemHeight="34" ItemWidth="148" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <DropDownButton x:Name="AddReminderButton" Content="+ Add reminder" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock x:Name="SubtasksTitle" Text="Subtasks" Style="{StaticResource SectionTitleStyle}" />
                <StackPanel x:Name="SubtaskList" Spacing="2" />
                <TextBox x:Name="NewSubtaskBox" PlaceholderText="Add a subtask and press Enter" KeyDown="NewSubtaskBox_KeyDown" AutomationProperties.Name="New subtask" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Attachments" Style="{StaticResource SectionTitleStyle}" />
                <StackPanel x:Name="AttachmentList" Spacing="6" />
                <Button x:Name="AttachButton" HorizontalAlignment="Stretch" Click="Attach_Click" ToolTipService.ToolTip="Ctrl+Shift+A">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE723;" FontSize="14" />
                        <TextBlock Text="Attach or drop a file (up to 10 MB)" />
                    </StackPanel>
                </Button>
                <InfoBar x:Name="AttachError" Severity="Error" IsOpen="False" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Name="TimeTitle" Text="Time spent" Style="{StaticResource SectionTitleStyle}" />
                <Grid ColumnSpacing="10" Padding="12,8" CornerRadius="6" Background="{ThemeResource AccentSoftBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TimerStatus" VerticalAlignment="Center" FontSize="13" Text="Timer stopped" />
                    <TextBlock x:Name="TimerElapsed" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource BrandAccentBrush}" />
                    <Button x:Name="TimerButton" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Content="Start" Click="Timer_Click" ToolTipService.ToolTip="Ctrl+T" />
                </Grid>
                <StackPanel x:Name="TimeEntriesList" Spacing="2" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <NumberBox x:Name="ManualMinutes" PlaceholderText="Minutes" Minimum="1" Maximum="1440" SpinButtonPlacementMode="Compact" Width="140" AutomationProperties.Name="Minutes to add" />
                    <Button Content="Add time" Click="AddTime_Click" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Notes" Style="{StaticResource SectionTitleStyle}" />
                <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" LostFocus="Field_LostFocus" AutomationProperties.Name="Notes" />
            </StackPanel>

            <Grid>
                <TextBlock x:Name="CreatedText" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                <Button HorizontalAlignment="Right" Click="Delete_Click" Foreground="{ThemeResource DangerBrush}" Background="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock Text="Delete task" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
