<Page
    x:Class="MyTodo.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="CountText" Foreground="{ThemeResource Text2Brush}" />
        </StackPanel>
        <StackPanel x:Name="Filters" Grid.Row="1" Orientation="Horizontal" Spacing="6" />
        <ListView x:Name="Results" Grid.Row="2" IsItemClickEnabled="True" ItemClick="Results_ItemClick" SelectionMode="None" AutomationProperties.Name="Search results">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{Binding Glyph}" FontSize="16" Foreground="{ThemeResource Text2Brush}" Visibility="{Binding ItemVisibility}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding Title}" FontWeight="{Binding TitleWeight}" Foreground="{Binding TitleBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{ThemeResource Text2Brush}" TextTrimming="CharacterEllipsis" Visibility="{Binding ItemVisibility}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</Page>
