<Page
    x:Class="MyTodo.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="28,20" Spacing="18" MaxWidth="980" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Changes save immediately. Everything stays on this PC." Foreground="{ThemeResource Text2Brush}" />
            </StackPanel>
            <InfoBar x:Name="Notice" IsOpen="False" />
            <StackPanel x:Name="Sections" Spacing="18" />
        </StackPanel>
    </ScrollViewer>
</Page>
