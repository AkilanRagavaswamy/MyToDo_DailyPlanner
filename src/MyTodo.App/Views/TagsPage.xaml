<Page
    x:Class="MyTodo.App.Views.TagsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <DataTemplate x:Key="TagCardTemplate">
            <Grid Padding="16,14" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{Binding SoftBrush}" CornerRadius="11" Padding="10,3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Display}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding ColorBrush}" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding UsageText}" VerticalAlignment="Center"
                           Style="{StaticResource SecondaryTextStyle}" />
                <Button Grid.Column="2" Content="Open" Click="Open_Click" Tag="{Binding Id}" VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding OpenLabel}" />
                <Button Grid.Column="3" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                        AutomationProperties.Name="{Binding MenuLabel}" ToolTipService.ToolTip="Tag options">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Edit" Icon="Edit" Click="Edit_Click" Tag="{Binding Id}" />
                            <MenuFlyoutItem Text="Delete" Icon="Delete" Click="Delete_Click" Tag="{Binding Id}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="28,20,28,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="Tags" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Tags are shared across every list. Create one here, then put it on any task."
                           Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <Button x:Name="NewTagButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center"
                    Click="NewTag_Click" AutomationProperties.Name="New tag">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="New tag" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar x:Name="UndoBar" Grid.Row="1" IsOpen="False" Severity="Informational" />

        <Grid Grid.Row="2">
            <ListView x:Name="TagsView" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Tag_ItemClick"
                      ItemTemplate="{StaticResource TagCardTemplate}" AutomationProperties.Name="Your tags">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
            <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" MaxWidth="380" Style="{StaticResource SecondaryTextStyle}"
                       Text="No tags yet. Create one here, or type #something in quick add and it will appear in this list." />
        </Grid>
    </Grid>
</Page>
