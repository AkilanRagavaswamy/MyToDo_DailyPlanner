<Application
    x:Class="MyTodo.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Themes/Brand.xaml" />
                <ResourceDictionary Source="Themes/TaskTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Planner green as the app accent. Removed at startup when "Use Windows accent" is on. -->
            <Color x:Key="SystemAccentColor">#1F8A5B</Color>
            <Color x:Key="SystemAccentColorLight1">#2FAE72</Color>
            <Color x:Key="SystemAccentColorLight2">#4CC38A</Color>
            <Color x:Key="SystemAccentColorLight3">#72D9A6</Color>
            <Color x:Key="SystemAccentColorDark1">#187A4E</Color>
            <Color x:Key="SystemAccentColorDark2">#136640</Color>
            <Color x:Key="SystemAccentColorDark3">#0E5A37</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
