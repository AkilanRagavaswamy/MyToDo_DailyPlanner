<Window
    x:Class="MyTodo.App.QuickAddWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Quick add">

    <!-- Chromeless popup: the window has no title bar, so this border is the whole visible surface. -->
    <Border x:Name="Root" CornerRadius="8" Padding="15">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE710;" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource BrandAccentBrush}" />
                <TextBox x:Name="Input" Grid.Column="1" FontSize="18" BorderThickness="0" Padding="0,2"
                         PlaceholderText="Prepare sprint demo fri 10am p2 #work"
                         AutomationProperties.Name="New task" TextChanged="Input_TextChanged" KeyDown="Input_KeyDown">
                    <!-- Flat input: the window itself is the field, so the default box chrome is cleared in every state. -->
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                    </TextBox.Resources>
                </TextBox>
            </Grid>

            <ScrollViewer Grid.Row="1" MinHeight="24" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden">
                <ItemsControl x:Name="Chips">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Background="{ThemeResource AccentSoftBrush}" CornerRadius="12" Padding="10,3">
                                <TextBlock Text="{x:Bind}" FontSize="12" Foreground="{ThemeResource BrandAccentBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Text="Enter save · Ctrl+Enter save and open · Esc close" />
                    <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Content="Add task" Click="Add_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
